diff --git a/tests/test_syntax/extensions/test_strikethrough.py b/tests/test_syntax/extensions/test_strikethrough.py
new file mode 100644
index 0000000..fc5a57f
--- /dev/null
+++ b/tests/test_syntax/extensions/test_strikethrough.py
@@ -0,0 +1,11 @@
+from markdown.test_tools import TestCase
+
+
+class TestStrikethrough(TestCase):
+    default_kwargs = {'extensions': ['strikethrough']}
+
+    def test_basic(self):
+        self.assertMarkdownRenders('~~gone~~ text', '<p><del>gone</del> text</p>')
+
+    def test_with_bold(self):
+        self.assertMarkdownRenders('~~**b**~~', '<p><del><strong>b</strong></del></p>')

diff --git c/markdown/extensions/strikethrough.py i/markdown/extensions/strikethrough.py
new file mode 100644
index 0000000..943c21b
--- /dev/null
+++ i/markdown/extensions/strikethrough.py
@@ -0,0 +1,12 @@
+"""Reference solution for issue 4 (used only to validate the hidden tests)."""
+from . import Extension
+from ..inlinepatterns import SimpleTagInlineProcessor
+
+
+class StrikethroughExtension(Extension):
+    def extendMarkdown(self, md):
+        md.inlinePatterns.register(SimpleTagInlineProcessor(r'(~{2})(?!~)(.+?)(?<!~)~{2}', 'del'), 'strikethrough', 55)
+
+
+def makeExtension(**kwargs):  # pragma: no cover
+    return StrikethroughExtension(**kwargs)
